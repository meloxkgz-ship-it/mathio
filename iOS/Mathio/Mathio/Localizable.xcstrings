        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les radians mesurent les angles par longueur d'arc. Un demi-cercle équivaut à π radians."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I radianti misurano gli angoli in base alla lunghezza dell'arco. Mezzo cerchio è π radianti."
