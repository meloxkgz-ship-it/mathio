    "Budgeting depends on summing categories and subtracting expenses from income": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Budgetierung basiert auf der Summierung der Kategorien und der Subtraktion der Ausgaben von den Einnahmen"
          }
        },
