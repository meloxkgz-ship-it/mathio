            "state": "translated",
            "value": "$200 cresce di 50% una volta. Importo finale?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "$200 cresce 50% uma vez. Valor final?"
          }
        }
      }
    },
