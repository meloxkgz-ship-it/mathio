    "A definite integral measures accumulated change — the signed area under a curve between two limits.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein bestimmtes Integral misst die aufsummierte Änderung — die vorzeichenbehaftete Fläche unter einer Kurve zwischen zwei Grenzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una integral definida mide el cambio acumulado: el área con signo bajo una curva entre dos límites."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une intégrale définie mesure le changement accumulé – la zone signée sous une courbe entre deux limites."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un integrale definito misura il cambiamento accumulato: l'area con segno sotto una curva tra due limiti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma integral definida mede a mudança acumulada – a área assinada sob uma curva entre dois limites."
          }
        }
      }
    },
