    "Compound interest applies to the updated balance": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für den aktualisierten Saldo gilt der Zinseszins"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El interés compuesto se aplica al saldo actualizado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les intérêts composés s'appliquent au solde mis à jour"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'interesse composto si applica al saldo aggiornato"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os juros compostos incidem sobre o saldo atualizado"
          }
        }
      }
    },
    "Compound interest earns interest on the growing balance, so growth accelerates over time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch den Zinseszins werden Zinsen auf den wachsenden Saldo generiert, sodass sich das Wachstum mit der Zeit beschleunigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El interés compuesto genera intereses sobre el saldo creciente, por lo que el crecimiento se acelera con el tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les intérêts composés rapportent des intérêts sur le solde croissant, de sorte que la croissance s’accélère avec le temps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’interesse composto guadagna interessi sul saldo crescente, quindi la crescita accelera nel tempo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os juros compostos geram juros sobre o saldo crescente, de modo que o crescimento acelera com o tempo."
          }
        }
      }
    },
    "Compound interest usually grows faster than simple interest because:": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zinseszins wächst normalerweise schneller als der einfache Zins, weil:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El interés compuesto suele crecer más rápido que el interés simple porque:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les intérêts composés augmentent généralement plus rapidement que les intérêts simples car :"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’interesse composto di solito cresce più velocemente dell’interesse semplice perché:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os juros compostos geralmente crescem mais rápido do que os juros simples porque:"
          }
        }
      }
    },
