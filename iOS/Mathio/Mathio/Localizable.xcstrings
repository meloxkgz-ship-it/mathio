    "Free for 3 days, then %@/week. Renews automatically unless cancelled at least 24 h before the period ends. Manage in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "3 Tage gratis, dann %@/Woche. Verlängert sich automatisch, sofern nicht mindestens 24 Std. vor Periodenende gekündigt wird. Verwalten in den Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis por 3 días, luego %@/semana. Se renueva automáticamente a menos que se cancele al menos 24 h antes de que finalice el período. Administrar en Configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuit pendant 3 jours, puis %@/semaine. Se renouvelle automatiquement sauf annulation au moins 24 h avant la fin de la période. Gérer dans Paramètres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis per 3 giorni, poi %@/settimana. Si rinnova automaticamente salvo disdetta almeno 24 ore prima della fine del periodo. Gestisci in Impostazioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuito por 3 dias e depois %@/semana. Renova automaticamente, a menos que seja cancelado pelo menos 24 horas antes do término do período. Gerenciar em Configurações."
          }
        }
      }
    },
    "Free for 7 days, then %@/year. Renews automatically unless cancelled at least 24 h before the period ends. Manage in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "7 Tage gratis, dann %@/Jahr. Verlängert sich automatisch, sofern nicht mindestens 24 Std. vor Periodenende gekündigt wird. Verwalten in den Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis durante 7 días, luego %@/año. Se renueva automáticamente a menos que se cancele al menos 24 h antes de que finalice el período. Administrar en Configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuit pendant 7 jours, puis %@/an. Se renouvelle automatiquement sauf annulation au moins 24 h avant la fin de la période. Gérer dans Paramètres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis per 7 giorni, poi %@/anno. Si rinnova automaticamente salvo disdetta almeno 24 ore prima della fine del periodo. Gestisci in Impostazioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuito por 7 dias e depois %@/ano. Renova automaticamente, a menos que seja cancelado pelo menos 24 horas antes do término do período. Gerenciar em Configurações."
          }
        }
      }
    },
