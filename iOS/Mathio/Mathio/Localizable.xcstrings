    "Inflation changes purchasing power, so real value compares money after price changes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Inflation verändert die Kaufkraft, sodass der reale Wert dem Geld nach Preisänderungen entspricht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La inflación cambia el poder adquisitivo, por lo que el valor real se compara con el dinero después de los cambios de precios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’inflation modifie le pouvoir d’achat, donc la valeur réelle compare l’argent après les changements de prix."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’inflazione modifica il potere d’acquisto, quindi il valore reale confronta il denaro dopo le variazioni dei prezzi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A inflação altera o poder de compra, de modo que o valor real compara o dinheiro após as alterações de preço."
