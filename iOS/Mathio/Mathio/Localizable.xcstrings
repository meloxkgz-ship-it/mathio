            "value": "El presupuesto es aritmética aplicada: ingresos, gastos, tasa de ahorro y compensaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La budgétisation est une arithmétique appliquée : revenus, dépenses, taux d’épargne et compromis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il budget viene applicato con l’aritmetica: entrate, spese, tasso di risparmio e compromessi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
