    "Good data starts with a fair sample. Bias sneaks in when some outcomes or people are overrepresented.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gute Daten beginnen mit einer fairen Stichprobe. Voreingenommenheit schleicht sich ein, wenn bestimmte Ergebnisse oder Personen überrepräsentiert sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los buenos datos comienzan con una muestra justa. El sesgo se cuela cuando algunos resultados o personas están sobrerrepresentadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De bonnes données commencent par un échantillon équitable. Des préjugés apparaissent lorsque certains résultats ou certaines personnes sont surreprésentés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I buoni dati iniziano con un campione equo. I pregiudizi si insinuano quando alcuni risultati o persone sono sovrarappresentati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bons dados começam com uma amostra justa. O preconceito surge quando alguns resultados ou pessoas estão super-representados."
          }
        }
      }
    },
