    "Surface area is the total area of every face of a solid — measured in square units.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Oberfläche ist der Gesamtflächeninhalt aller Flächen eines Körpers — gemessen in Quadrateinheiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El área de superficie es el área total de cada cara de un sólido, medida en unidades cuadradas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La superficie est la superficie totale de chaque face d'un solide, mesurée en unités carrées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'area superficiale è l'area totale di ogni faccia di un solido, misurata in unità quadrate."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A área de superfície é a área total de cada face de um sólido – medida em unidades quadradas."
          }
        }
      }
    },
