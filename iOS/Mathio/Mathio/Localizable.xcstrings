    "A function takes an input and returns exactly one output. f(x) is read 'f of x'.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Funktion nimmt eine Eingabe und gibt genau eine Ausgabe zurück. f(x) liest man „f von x“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una función toma una entrada y devuelve exactamente una salida. f(x) se lee 'f de x'."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fonction prend une entrée et renvoie exactement une sortie. f(x) est lu 'f de x'."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una funzione riceve un input e restituisce esattamente un output. f(x) si legge 'f di x'."
