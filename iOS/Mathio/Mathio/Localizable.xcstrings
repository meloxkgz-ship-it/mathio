    "Sequences are ordered lists of numbers. Patterns can grow by addition, multiplication, or custom rules.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folgen sind geordnete Zahlenlisten. Muster können durch Addition, Multiplikation oder benutzerdefinierte Regeln wachsen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las secuencias son listas ordenadas de números. Los patrones pueden crecer mediante suma, multiplicación o reglas personalizadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les séquences sont des listes ordonnées de nombres. Les modèles peuvent se développer par addition, multiplication ou règles personnalisées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sequenze sono elenchi ordinati di numeri. I modelli possono crescere mediante addizione, moltiplicazione o regole personalizzate."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As sequências são listas ordenadas de números. Os padrões podem crescer por adição, multiplicação ou regras personalizadas."
          }
        }
      }
    },
