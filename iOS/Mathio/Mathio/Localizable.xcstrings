    "Probability measures how likely an event is, from 0 for impossible to 1 for certain.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wahrscheinlichkeit misst, wie wahrscheinlich ein Ereignis ist, von 0 für unmöglich bis 1 für sicher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La probabilidad mide la probabilidad de que ocurra un evento, desde 0 para imposible hasta 1 para seguro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La probabilité mesure la probabilité d'un événement, de 0 pour impossible à 1 pour certain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La probabilità misura quanto è probabile un evento, da 0 per impossibile a 1 per certo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A probabilidade mede a probabilidade de um evento, de 0 para impossível a 1 para certo."
