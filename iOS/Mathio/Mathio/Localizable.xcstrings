    "Questions return right before you'd forget them, so it actually sticks.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgaben kommen wieder, kurz bevor du sie vergisst — so bleibt es wirklich hängen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las preguntas regresan justo antes de que las olvides, por lo que en realidad se quedan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les questions reviennent juste avant que vous ne les oubliiez, donc ça colle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le domande ritornano subito prima che tu le dimentichi, quindi in realtà si attacca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As perguntas retornam logo antes de você esquecê-las, então elas realmente permanecem."
          }
        }
      }
    },
