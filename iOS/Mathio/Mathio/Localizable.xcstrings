    "$1,000 loan at 12% annual interest has what monthly interest for one month?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "$1,000 Darlehen mit 12% Jahreszins hat welche monatlichen Zinsen für einen Monat?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué interés mensual tiene el préstamo $1,000 a 12% interés anual durante un mes?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prêt $1,000 à 12% intérêt annuel a quel intérêt mensuel pour un mois ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il prestito $1,000 a 12% interesse annuo ha quale interesse mensile per un mese?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O empréstimo de $1,000 com juros anuais de 12% tem quais juros mensais por um mês?"
          }
        }
      }
    },
    "$100 after 5% inflation has about what real value in today's dollars? Round to cents.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "$100 nach 5% Welchen realen Wert hat die Inflation in heutigen Dollars? Auf Cent runden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "$100 después de 5% ¿qué valor real tiene la inflación en dólares de hoy? Redondear a centavos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "$100 après 5%, quelle est la valeur réelle de l'inflation en dollars d'aujourd'hui ? Arrondir au centime."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "$100 dopo il 5% quale valore reale avrà l'inflazione in dollari odierni? Arrotondare ai centesimi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "$100 depois de 5% a inflação tem aproximadamente qual valor real em dólares de hoje? Arredondar para centavos."
          }
        }
      }
    },
    "$100 grows by 10% for 2 years, compounded yearly. Final amount?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "$100 wächst 2 Jahre lang um 10%, jährlich erhöht. Endbetrag?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "$100 crece en 10% durante 2 años, compuesto anualmente. ¿Cantidad final?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "$100 augmente de 10% pendant 2 ans, composé chaque année. Montant final ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "$100 cresce di 10% per 2 anni, con capitalizzazione annuale. Importo finale?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "$100 cresce em 10% por 2 anos, composto anualmente. Valor final?"
          }
        }
      }
    },
    "$200 earns 5% simple interest for 1 year. How much interest is earned?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "$200 bringt 1 Jahr lang 5% einfache Zinsen. Wie viel Zinsen werden verdient?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "$200 gana 5% interés simple durante 1 año. ¿Cuánto interés se gana?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "$200 rapporte 5% intérêts simples pendant 1 an. Quel est le montant des intérêts gagnés ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "$200 guadagna 5% interessi semplici per 1 anno. Quanti interessi vengono guadagnati?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "$200 ganha 5% juros simples por 1 ano. Quanto de juros são ganhos?"
          }
        }
      }
    },
    "$200 grows by 50% once. Final amount?": {
      "localizations": {
